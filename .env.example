# Firebase Realtime Database Configuration
# Format: https://<your-project-id>-default-rtdb.<region>.firebasedatabase.app
FIREBASE_URL=

# Firebase Database Secret (Legacy token) atau credential auth server
FIREBASE_SECRET=

# Password kuat untuk login ke Admin Panel KIMTV (wajib diganti sebelum production)
ADMIN_PASSWORD=

# Opsional: Secret acak panjang untuk menandatangani cookie sesi HttpOnly Admin
# Jika kosong, server akan menurunkannya dari ADMIN_PASSWORD
SESSION_SECRET=
